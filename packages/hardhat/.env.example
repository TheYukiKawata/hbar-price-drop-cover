# Hedera JSON-RPC endpoints. Leave empty to use Hashio.
HEDERA_TESTNET_RPC_URL=
HEDERA_MAINNET_RPC_URL=

# Written by `yarn hardhat:account:generate` or `yarn hardhat:account:import`. Do not fill by hand.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Optional: cover length in seconds. Use 600 to watch a policy resolve during a demo. Default: one week.
COVER_PERIOD_SECONDS=

# Optional: HBAR sent to create the policy NFT collection. Default: 15.
POLICY_TOKEN_CREATION_FEE_HBAR=
